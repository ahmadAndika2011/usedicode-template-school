<!-- form signup -->
<div class="auth-modal" id="auth-modal" hidden>
  <div class="auth-panel" role="dialog" aria-modal="true" aria-labelledby="auth-title">
    <button type="button" class="auth-close" id="auth-close" aria-label="Tutup">&times;</button>
    <h2 id="auth-title">Daftar ke SMA Nusantara</h2>

    <!-- Langkah 1: verifikasi Google -->
    <div class="auth-step" id="auth-step-google">
      <p>Verifikasi dulu dengan akun Google kamu.</p>
      <div id="google-btn"></div>
    </div>

    <!-- Langkah 2: lengkapi data -->
    <form class="auth-step" id="signup-form" hidden>
      <p>Halo, <strong id="signup-name"></strong>! Lengkapi data akunmu.</p>

      <label for="signup-username">Username</label>
      <input type="text" id="signup-username" name="username"
             required minlength="3" maxlength="30" autocomplete="username">

      <label for="signup-password">Password</label>
      <input type="password" id="signup-password" name="password"
             required minlength="8" maxlength="72" autocomplete="new-password">

      <label for="signup-idsiswa">ID Siswa <span class="auth-optional">(opsional)</span></label>
      <input type="text" id="signup-idsiswa" name="id_siswa" autocomplete="off">

      <button type="submit" class="auth-submit" id="signup-submit">Daftar</button>
    </form>

    <p class="auth-error" id="auth-error" role="alert"></p>
  </div>
</div>
